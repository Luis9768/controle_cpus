generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String   @default("user") // admin ou user
}

model Cpu {
  id        String   @id // ID Patrimônio (Ex: CPU-1234)
  name      String   // Nome Anydesk
  location  String   // 'estoque' ou nome da sala
  date      String
}

model Room {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  pas       String[] // Array de números de PA (ex: ["01", "02"])
}

model HeadsetStock {
  id        Int      @id @default(autoincrement())
  brand     String   @unique
  quantity  Int      @default(0)
}

model HeadsetDefect {
  id         Int      @id @default(autoincrement())
  date       String
  returnDate String?
  brand      String
  defect     String
  status     String   // Aguardando, Enviada, Resolvido
  box        String
}

model History {
  id        Int      @id @default(autoincrement())
  date      String
  action    String
  cpu       String?
  from      String?
  to        String?
  brand     String?
  qty       Int?
  details   String?
}
